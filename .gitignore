# Build output. `build-app/` is a SECOND build directory rather than a variant of the
# first: the JUCE app target fetches and compiles JUCE, which is slow, and keeping it
# out of `build/` means the headless core/test build stays fast and can be wiped
# independently. HANDOVER.md §9 requires rebuilding from scratch to verify a patch
# series, and nobody does that willingly if it drags a framework build along with it.
build/
build-app/
*.o
*.a

# Rendered audio. Everything here is REGENERABLE from the tools and none of it
# should be in history: vh_demo, vh_render and sweep_range.py rewrite it wholesale,
# so committing it produces enormous binary diffs that convey nothing. Regenerate
# with ./build/vh_demo ./audio and tools/sweep_range.py.
audio/
sweep/
out/
out2/
inspect/
*.wav

# The two validation recordings are CC material and are fetched, not committed.
# See ATTRIBUTION.txt and tools/fetch_test_audio.sh.
sustained_dry.wav
melody_dry.wav

__pycache__/

# Regenerable measurement output from tools/demo_battery.py. Same rule as the audio
# above: the tool rewrites it wholesale, so committing it is a binary-ish diff that
# conveys nothing the printed table does not.
demo_new/battery_report.json
